# Referencia: exportar estas variables en el terminal antes de ejecutar.
# Python NO carga este archivo ni .env automaticamente.
# Los valores relativos se resuelven desde la raiz del proyecto.
DATALOGGER_DATA_DIR=data
DATALOGGER_LOG_DIR=logs
# Opcionales; sin definirlos se usan las rutas dentro de DATALOGGER_DATA_DIR:
# DATALOGGER_ARCHIVE=data/raw/beaglebone_programacion_01.tar
# DATALOGGER_DATABASE=data/database/historicos.sqlite
# DATALOGGER_UNITS=data/raw/extraido/home/actemium/apps/xthreeconpi/config/units.txt
# Solo para el lanzador Windows: ruta local a python.exe, sin comillas en el valor.
# DATALOGGER_PYTHON=
# El visor no utiliza credenciales FTP, SSH ni de la BeagleBone.
