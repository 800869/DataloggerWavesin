# Datos y evidencias locales: conservar en disco, nunca publicar.
/data/
/logs/
/docs/private/
/backups/
/tmp/
/temp/

# Ubicaciones antiguas: solo se versionan los lanzadores de compatibilidad.
/BEAGLEBONE/*
!/BEAGLEBONE/analizar_copia.py
!/BEAGLEBONE/analizar_historicos.py
!/BEAGLEBONE/inspeccionar_java.py
!/BEAGLEBONE/analisis/
/BEAGLEBONE/analisis/*
!/BEAGLEBONE/analisis/visor_historicos.py
!/BEAGLEBONE/analisis/Abrir_visor.cmd

